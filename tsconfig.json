{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "cypress"
  ],
  // Read only by ts-node, which Cypress uses to load cypress.config.js: it
  // cannot run with the expo base's bundler-only options under TS 6.
  "ts-node": {
    "compilerOptions": {
      "customConditions": null,
      "ignoreDeprecations": "6.0"
    }
  }
}
